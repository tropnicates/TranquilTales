{
  "name": "tranquil-tales",
  "version": "2.0.0",
  "private": true,
  "description": "A full-stack blog built with Express, React, and Vite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "vite --config vite.config.js",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "build": "vite build --config vite.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.39.0",
    "connect-mongo": "^5.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mongoose": "^7.4.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^2.0.20",
    "vite": "^6.1.0"
  }
}
